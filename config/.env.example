# Mythic Video Studio local configuration
# Copy to .env in the repo root (not this config/ dir). Never commit real secrets.
# See tools/flux_image.py and tools/chatterbox_tts.py for two working local adapters
# (mflux/FLUX.1-schnell for images, Chatterbox Multilingual for Hindi TTS) that already
# implement this contract on this machine.

# Local image generator adapter. The command is invoked with argsTemplate (tokens
# {job}/{output}/{reference} are substituted) followed by the job JSON as a final arg.
# FLUX_COMMAND / FLUX_ARGS are accepted as fallback names.
IMAGE_GENERATOR_COMMAND=
IMAGE_GENERATOR_ARGS=

# Which local Hindi TTS engine to use by default: chatterbox (default if unset) or vibevoice.
# A manifest's own audio.provider (set via the Studio UI's Voice Engine selector) overrides this
# per-project. See src/pipeline/tts-provider.ts.
TTS_PROVIDER=chatterbox

# Local Hindi TTS adapter #1: Chatterbox (voice cloning, the default/safe production path).
# CHATTERBOX_COMMAND / CHATTERBOX_ARGS / CHATTERBOX_VOICE / CHATTERBOX_REFERENCE_AUDIO are
# accepted as fallback names. See tools/chatterbox_tts.py.
TTS_COMMAND=
TTS_ARGS=
TTS_VOICE=
TTS_REFERENCE_AUDIO=

# Local Hindi TTS adapter #2: VibeVoice Hindi 7B (long-form, multi-speaker-capable; heavier —
# recommends an NVIDIA GPU with ~24GB VRAM, or Apple Silicon via MPS). Coexists with Chatterbox
# above; select it per-project via the Studio UI, or make it the default with TTS_PROVIDER above.
# See tools/vibevoice_tts.py for the full contract and docs/RUNNING_LOCALLY.md for setup.
VIBEVOICE_COMMAND=
VIBEVOICE_ARGS=
VIBEVOICE_VOICE=
VIBEVOICE_REFERENCE_AUDIO=
# Absolute path to a cloned https://github.com/vibevoice-community/VibeVoice checkout.
VIBEVOICE_REPO_DIR=
# Hugging Face model id or local path. Defaults to tarun7r/vibevoice-hindi-7b if unset.
VIBEVOICE_MODEL_PATH=
# auto (default; tries CUDA, then MPS, then CPU) | cuda | mps | cpu
VIBEVOICE_DEVICE=

# Optional music and SFX command adapters (not yet wired into the pipeline).
MUSIC_COMMAND=
SFX_COMMAND=

# Output controls.
OUTPUT_DIR=projects
ASSET_DIR=assets
RENDER_DIR=renders

# Rendering defaults.
VIDEO_FPS=30
SHORT_WIDTH=1080
SHORT_HEIGHT=1920
LONG_WIDTH=1920
LONG_HEIGHT=1080
