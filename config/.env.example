# Mythic Video Studio local configuration
# Copy to .env. Never commit real secrets.

# Optional FLUX integration.
# Supported adapter modes will include direct command and HTTP/ComfyUI.
FLUX_MODE=command
FLUX_COMMAND=
FLUX_MODEL_PATH=
FLUX_ENDPOINT=

# Hindi voice / Chatterbox integration.
TTS_MODE=command
TTS_COMMAND=
TTS_MODEL_PATH=
TTS_ENDPOINT=
TTS_VOICE_PATH=

# Optional music and SFX command adapters.
MUSIC_COMMAND=
SFX_COMMAND=

# Output controls.
OUTPUT_DIR=projects
ASSET_DIR=assets
RENDER_DIR=renders

# Rendering defaults.
VIDEO_FPS=30
SHORT_WIDTH=1080
SHORT_HEIGHT=1920
LONG_WIDTH=1920
LONG_HEIGHT=1080
