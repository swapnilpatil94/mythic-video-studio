{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythic Video Short Manifest",
  "type": "object",
  "required": ["project_id", "title", "language", "duration_seconds", "characters", "beats"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"const": "hi-IN"},
    "duration_seconds": {"type": "number", "minimum": 45, "maximum": 120},
    "characters": {"type": "array", "items": {"type": "string"}},
    "tempo_profile": {"enum": ["short", "medium", "longform"]},
    "narration_profile": {
      "type": "object",
      "properties": {
        "target_wpm": {"type": "number", "minimum": 100, "maximum": 220},
        "max_pause_seconds": {"type": "number", "minimum": 0.1, "maximum": 2},
        "speed_factor": {"type": "number", "minimum": 0.8, "maximum": 1.2}
      }
    },
    "beats": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["beat_id", "duration_seconds", "visual_role", "asset_refs"],
        "properties": {
          "beat_id": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "visual_role": {"type": "string"},
          "asset_refs": {"type": "array", "items": {"type": "string"}},
          "new_asset_required": {"type": "boolean"},
          "camera": {"type": "string"},
          "animation": {"type": "string"},
          "text": {"type": "string"},
          "narration": {"type": "string"},
          "kinetic_keywords": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
