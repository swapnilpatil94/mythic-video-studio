{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KATHAAYA Story Package",
  "description": "KATHAAYA story package with an explicit world/era bible so characters, environments, props, lighting and motion belong to one cinematic world.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "story", "script", "characters", "environments", "props", "visual_manifest", "audio", "metadata", "sources"],
  "properties": {
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "project_name", "format", "target_duration_seconds"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "project_name": {"type": "string", "minLength": 1},
        "format": {"enum": ["SHORT", "LONGFORM"]},
        "language": {"type": "string", "minLength": 2, "default": "hi-IN"},
        "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "story": {
      "type": "object", "additionalProperties": false, "required": ["title", "hook"],
      "properties": {
        "title": {"type": "string", "minLength": 1}, "hook": {"type": "string", "minLength": 1},
        "premise": {"type": "string"}, "conflict": {"type": "string"}, "reveal": {"type": "string"},
        "climax": {"type": "string"}, "payoff": {"type": "string"}, "emotional_core": {"type": "string"},
        "story_arc": {"type": "string"}, "facts": {"type": "array", "items": {"type": "string"}},
        "interpretations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "script": {
      "type": "object", "additionalProperties": false, "required": ["full_narration", "beats"],
      "properties": {
        "full_narration": {"type": "string", "minLength": 1}, "target_wpm": {"type": "number", "exclusiveMinimum": 0},
        "beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/script_beat"}}
      }
    },
    "world": {"$ref": "#/$defs/world_bible"},
    "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
    "environments": {"type": "array", "items": {"$ref": "#/$defs/environment"}},
    "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
    "visual_manifest": {
      "type": "object", "additionalProperties": false, "required": ["beats"],
      "properties": {"beats": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visual_beat"}}}
    },
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["voice_style"],
      "properties": {
        "voice_style": {"type": "string", "minLength": 1}, "target_wpm": {"type": "number", "exclusiveMinimum": 0},
        "music_direction": {"type": "string"}, "sfx": {"type": "array", "items": {"type": "string"}},
        "silence_guidance": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["youtube_title", "description"],
      "properties": {
        "youtube_title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}, "hashtags": {"type": "array", "items": {"type": "string"}},
        "thumbnail_concept": {"type": "string"}, "seo_keywords": {"type": "array", "items": {"type": "string"}}, "social_caption": {"type": "string"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "world_bible": {
      "type": "object", "additionalProperties": false,
      "required": ["period", "architecture", "clothing", "weapons", "armor", "jewelry", "vehicles", "materials", "environment", "lighting"],
      "properties": {
        "period": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1},
        "clothing": {"type": "string", "minLength": 1}, "weapons": {"type": "string", "minLength": 1},
        "armor": {"type": "string", "minLength": 1}, "jewelry": {"type": "string", "minLength": 1},
        "vehicles": {"type": "string", "minLength": 1}, "materials": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}, "lighting": {"type": "string", "minLength": 1},
        "atmosphere": {"type": "string"}, "forbidden_modern_elements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "script_beat": {
      "type": "object", "additionalProperties": false, "required": ["id", "narration", "duration_seconds"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "narration": {"type": "string", "minLength": 1},
        "emotion": {"type": "string"}, "pace": {"type": "string"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "character": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "role": {"type": "string"},
        "importance": {"enum": ["primary", "secondary", "minor"]}, "visual_direction": {"type": "string"},
        "required_views": {"type": "array", "items": {"type": "string"}}, "required_actions": {"type": "array", "items": {"type": "string"}},
        "sacred_or_respected": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "visual_direction": {"type": "string"}, "important_layers": {"type": "array", "items": {"type": "string"}},
        "depth_layers": {"type": "array", "items": {"type": "string"}},
        "ambient_motion": {"type": "array", "items": {"type": "string"}},
        "era_constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "prop": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "required_views": {"type": "array", "items": {"type": "string"}}, "required_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "visual_beat": {
      "type": "object", "additionalProperties": false, "required": ["id", "scene_role", "camera"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "narration": {"type": "string"}, "scene_role": {"type": "string", "minLength": 1},
        "pace": {"type": "string"}, "shot_type": {"type": "string"}, "composition": {"type": "string"},
        "visual_action": {"type": "string"}, "animation": {"type": "string", "description": "Character action plus secondary environmental motion; should respect the era/world bible."},
        "characters": {"type": "array", "items": {"type": "string"}}, "props": {"type": "array", "items": {"type": "string"}},
        "environments": {"type": "array", "items": {"type": "string"}}, "camera": {"type": "string", "minLength": 1},
        "reveal": {"type": "boolean"}, "keyword_text": {"type": "string"}, "sfx": {"type": "array", "items": {"type": "string"}}, "transition": {"type": "string"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["source", "fact_or_interpretation"],
      "properties": {"source": {"type": "string", "minLength": 1}, "claim_supported": {"type": "string"}, "fact_or_interpretation": {"enum": ["fact", "interpretation"]}}
    }
  }
}
